{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Strava": {
    "BaseUrl": "https://www.strava.com/api/v3",
    "RateLimitPerMinute": 200
  },
  "Caching": {
    "SegmentCacheDurationMinutes": 60,
    "RouteCacheDurationMinutes": 120,
    "TrendsCacheDurationMinutes": 30
  }
}
